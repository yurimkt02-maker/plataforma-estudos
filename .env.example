# ==============================================================================
# PLATAFORMA PESSOAL DE QUESTÕES E SIMULADOS — CONFIGURAÇÃO DE AMBIENTE
# ==============================================================================
# NUNCA adicione o prefixo NEXT_PUBLIC_ a credenciais de banco, autenticação ou IA.
# NUNCA envie arquivos .env ou .env.local para o repositório Git.

# ------------------------------------------------------------------------------
# 1. PRISMA POSTGRES (Vercel Marketplace ou configuração manual)
# ------------------------------------------------------------------------------
# Conexão agrupada (Connection Pool) utilizada pela aplicação em runtime:
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST:5432/plataforma-estudos-dev?sslmode=require&pgbouncer=true"

# Conexão direta utilizada exclusivamente pelo Prisma CLI e Migrations:
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/plataforma-estudos-dev?sslmode=require"

# Quando provisionado via Vercel Marketplace (Prisma Postgres):
# DATABASE_URL normalmente representa a conexão direta; o prisma.config.ts e
# src/lib/db/prisma.ts resolvem automaticamente DATABASE_URL_POOLED e DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/plataforma-estudos-dev?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTENTICAÇÃO PRIVADA (USUÁRIO ÚNICO / PROPRIETÁRIO)
# ------------------------------------------------------------------------------
# Chave criptográfica de no mínimo 32 bytes (gere com: openssl rand -base64 32)
AUTH_SECRET=""

# Credenciais para inicialização segura da conta do proprietário no seed (nunca fixadas no código)
OWNER_EMAIL=""
OWNER_NAME="Proprietário"
OWNER_PASSWORD=""

# ------------------------------------------------------------------------------
# 3. CONFIGURAÇÕES DA APLICAÇÃO E ARMAZENAMENTO (VERCEL)
# ------------------------------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Vercel Blob (Armazenamento persistente privado de PDFs, provas e figuras)
BLOB_READ_WRITE_TOKEN=""
# Alternativa compatível com S3 (caso não utilize Vercel Blob)
S3_ENDPOINT=""
S3_BUCKET="plataforma-estudos-acervo"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="sa-east-1"

# ------------------------------------------------------------------------------
# 4. INTELIGÊNCIA ARTIFICIAL (MÓDULO DE EXPLICAÇÕES JURÍDICAS VERIFICÁVEIS)
# ------------------------------------------------------------------------------
AI_PROVIDER="gemini"
AI_API_KEY=""
AI_MODEL="gemini-2.5-pro"
